#!/usr/bin/env python3
"""Capsule Corp — Gravity Chamber control console.

Internal training service. Binds to localhost ONLY (not exposed to the network),
so it never appears in an external nmap: the player must get a shell as goku,
discover the listener (ss -tlnp), tunnel it (ssh -L 8081:127.0.0.1:8081) and
train at {{ gravity_target | default(100) }}x gravity to release the 5-star ball.

Runs as the `capsule` service account, so `goku` cannot read this script and
grep the flag out of it — the chamber must actually be used.
"""
import json
import urllib.parse
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

FLAG = "{{ flag_ball_5 }}"
GRAVITY_TARGET = {{ gravity_target | default(100) }}
HOST = "127.0.0.1"
PORT = {{ gravity_port | default(8081) }}

PAGE = """{% raw %}<!doctype html>
<html lang="es"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Cámara de Gravedad — Capsule Corp</title>
<style>
:root{--red:#e23b3b;--orange:#ed8936;--amber:#ffcf6b;--bg:#0d0b0e;--card:#1a1016;--line:#3a2630;--ink:#f0e6e0;--dim:#b08a8a;}
*{box-sizing:border-box;}
body{margin:0;font-family:"Segoe UI",system-ui,sans-serif;color:var(--ink);
  background:radial-gradient(1000px 600px at 50% -10%,#2a0f12,var(--bg) 70%);
  min-height:100vh;display:flex;align-items:center;justify-content:center;padding:30px 16px;}
.panel{width:100%;max-width:440px;background:linear-gradient(180deg,var(--card),#120a0e);
  border:1px solid var(--line);border-radius:16px;padding:26px 24px;box-shadow:0 24px 60px #000a;text-align:center;}
h1{margin:0 0 2px;font-size:19px;}
.sub{color:var(--dim);font-size:12px;letter-spacing:.12em;text-transform:uppercase;margin-bottom:18px;}
.chamber{position:relative;width:170px;height:170px;margin:6px auto 12px;border-radius:50%;
  background:radial-gradient(circle at 50% 40%,#3a1a1a,#140a0c);border:3px solid #4a2a2a;
  box-shadow:inset 0 0 40px #000,0 0 0 6px #0c0708;display:flex;align-items:center;justify-content:center;transition:box-shadow .3s;}
.chamber.max{box-shadow:inset 0 0 40px #000,0 0 32px #ffcf6b,0 0 0 6px #0c0708;animation:q .08s linear 8;}
@keyframes q{0%,100%{transform:translate(0,0);}50%{transform:translate(1px,-1px);}}
.aura{width:66px;height:92px;border-radius:50% 50% 45% 45%;background:radial-gradient(circle at 50% 40%,#ffe8a8,#ed8936);
  filter:blur(2px);opacity:.22;transition:opacity .3s,transform .3s;}
.chamber.max .aura{opacity:.95;transform:scale(1.3);}
.read{font-family:ui-monospace,monospace;font-size:34px;font-weight:800;color:var(--amber);margin:4px 0;}
.read.max{color:var(--red);}
input[type=range]{width:100%;accent-color:var(--orange);}
button{margin-top:16px;width:100%;padding:12px;border:0;border-radius:10px;font-size:15px;font-weight:800;
  background:linear-gradient(180deg,var(--amber),var(--orange));color:#5c2708;cursor:pointer;}
button:hover{filter:brightness(1.08);}
.msg{margin-top:14px;font-size:13px;color:var(--dim);min-height:18px;line-height:1.5;}
.ball{margin-top:16px;padding:14px;border-radius:12px;background:#171206;border:1px solid #4a3a12;display:none;}
.ball.show{display:block;}
.ball .t{font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--orange);}
.ball code{display:block;margin-top:6px;font-family:ui-monospace,monospace;font-size:16px;color:var(--amber);word-break:break-all;}
</style></head>
<body>
<div class="panel">
  <h1>Cámara de Gravedad</h1>
  <div class="sub">Capsule Corp · West City · Sala de Entrenamiento</div>
  <div class="chamber" id="chamber"><div class="aura"></div></div>
  <div class="read" id="read">x1</div>
  <input type="range" id="g" min="1" max="100" value="1">
  <button id="train">¡ENTRENAR!</button>
  <div class="msg" id="msg">Ajusta la gravedad y entrena.</div>
  <div class="ball" id="ball"><div class="t">⭐ Esfera de 5 Estrellas</div><code id="ballcode"></code></div>
</div>
<script>
const g=document.getElementById('g'),read=document.getElementById('read'),ch=document.getElementById('chamber');
function upd(){read.textContent='x'+g.value;read.className='read'+(g.value>=100?' max':'');}
g.addEventListener('input',upd);
document.getElementById('train').addEventListener('click',async()=>{
  const val=g.value, msg=document.getElementById('msg');
  msg.textContent='Entrenando a x'+val+' de gravedad...';
  let d;
  try{ d=await (await fetch('/train?gravity='+val)).json(); }
  catch(e){ msg.textContent='La camara no responde.'; return; }
  if(d.status==='ok'){
    ch.classList.add('max');
    msg.innerHTML='<span style="color:#ffcf6b;font-weight:700">¡PODER MAXIMO! El entrenamiento revela la esfera.</span>';
    document.getElementById('ballcode').textContent=d.ball5;
    document.getElementById('ball').classList.add('show');
  }else{
    ch.classList.remove('max');
    msg.textContent='Gravedad insuficiente (x'+d.gravity+'). Necesitas x'+d.need+' para liberar la esfera.';
  }
});
</script>
</body></html>{% endraw %}"""


class Handler(BaseHTTPRequestHandler):
    def _send(self, code, body, ctype="text/html; charset=utf-8"):
        data = body.encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        u = urllib.parse.urlparse(self.path)
        if u.path in ("/", "/index.html"):
            self._send(200, PAGE)
        elif u.path == "/train":
            q = urllib.parse.parse_qs(u.query)
            try:
                gravity = int(q.get("gravity", ["0"])[0])
            except ValueError:
                gravity = 0
            if gravity >= GRAVITY_TARGET:
                self._send(200, json.dumps({"status": "ok", "gravity": gravity, "ball5": FLAG}),
                           "application/json")
            else:
                self._send(200, json.dumps({"status": "weak", "gravity": gravity, "need": GRAVITY_TARGET}),
                           "application/json")
        else:
            self._send(404, "Not found")

    def log_message(self, *args):
        return


if __name__ == "__main__":
    ThreadingHTTPServer.allow_reuse_address = True
    ThreadingHTTPServer((HOST, PORT), Handler).serve_forever()
